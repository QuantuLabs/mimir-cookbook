{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "packages/*/src",
    "packages/*/vite-plugin.ts",
    "recipes/*/vite.config.ts",
    "recipes/*/src",
    "scripts"
  ]
}
